{{template "top" .}}
<title>Orderan Martabak</title>
</head>
<body class="bg-gradient-to-br from-amber-50 via-range-50 to-rose-50 min-h-screen">
    <div class="flex items-center justify-center p-6 md:p-8">
        <div class="bg-white/80 backdrop-blur-sm p-8 md:p-10 rounded-3xl shadow-xl border border-white/20 max-w-2xl w-full">
            <h1 class="text-4xl font-bold text-gray-900 mb-8 text-center tracking-tight">Orderan Baru Martabak</h1>
            
            <!-- Form for customer order -->
            <form action="/new-order" method="POST" class="space-y-6">
                <div class="space-y-5">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">
                        Customer Information
                    </h2>

                    <!-- Customer information fields -->
                    <div>
                        <!-- Name field -->
                        <label class="block text-gray-700 text-sm font-medium mb-2" for="name">Nama(*)</label>
                        <input class="w-full p-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all" type="text" name="name" id="name" required minlength="3" maxlength="50" placeholder="Name">
                        <p id="name-error" class="text-red-500 text-sm mt-1 hidden">Nama Harus diisi!</p>
                    </div>
                    <div>
                        <!-- Phone field -->
                        <label class="block text-gray-700 text-sm font-medium mb-2" for="phone">Telepon(*)</label>
                        <input class="w-full p-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all" type="text" name="phone" id="phone" required inputmode="numeric" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g,'')" minlength="8" maxlength="15" placeholder="Phone">
                        <p id="phone-error" class="text-red-500 text-sm mt-1 hidden">Telepon Harus diisi!</p>
                    </div>
                    <div>
                        <!-- Address field -->
                        <label class="block text-gray-700 text-sm font-medium mb-2" for="address">Alamat(*)</label>
                        <input class="w-full p-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all" type="text" name="address" id="address" required minlength="5" maxlength="200" placeholder="Address">
                        <p id="address-error" class="text-red-500 text-sm mt-1 hidden">Alamat Harus diisi!</p>
                    </div>
                </div>

                <!-- Martabak order section -->
                <div class="space-y-5">
                    <div class="flex justify-between item-center">
                        <h2 class="text-xl font-semibold text-gray-800">Pesanan Martabak</h2>
                        <button type="button" onclick="addMartabak()" class="px-4 py-2 text-sm font-medium text-emerald-600 havor:text-emerald-700 border border-emerald-300 rounded-xl hover:border-emerald-400 hover:bg-emerald-50 active:scale-95 transition-all">
                            Tambah Pesanan
                        </button>
                    </div>
                    <div id="martabak" class="space-y-4"></div>
                </div>
                <button type="submit" class="w-full bg-emerald-500 text-white font-semibold py-3 px-3 rounded-xl hover:bg-emerald-600 active:scale-[0.99] transition-all shadow-lg shadow-emerald-500/30">
                    Submit Order
                </button>
            </form>
        </div>
    </div>
    
    <template id="martabakTemplate">
        <div class="martabak-item border border-gray-200 rounded-2xl p-5 bg-gray-50/50">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Martabak <span class="martabak-number"></span></h3>
                <button type="button" onClick="removeMartabak(this)" class="text-red-500 hover:text-red-700 font-medium text-sm transition-colors">
                    Remove
                </button>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="block text-gray-700 text-sm font-medium md-2">Size Martabak</label>
                    <select name="sizes" required class="w-full p-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all bg-white">
                        {{range $.MartabakSizes}}
                        <option value="{{.}}">{{.}}</option>
                        {{end}}
                    </select>
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium md-2">Variant Martabak</label>
                    <select name="martabak" required class="w-full p-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all bg-white">
                        {{range $.MartabakTypes}}
                        <option value="{{.}}">{{.}}</option>
                        {{end}}
                    </select>
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium md-2">Catatan tambahan</label>
                    <textarea maxlength="200" name="instructions" rows="2" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 focus-border-transparent transition-all resize-none" placeholder="Additional Notes"></textarea>
                </div>
            </div>
        </div>
    </template>

    
<script>
    // adding and removing martabak script
    let martabakCount = 0;

    function addMartabak() {
        const clone = document.getElementById('martabakTemplate').content.cloneNode(true);
        clone.querySelector('.martabak-number').textContent = ++martabakCount;
        document.getElementById('martabak').appendChild(clone)
    }
    function removeMartabak(btn) {
        btn.closest(".martabak-item").remove();
        
        document.querySelectorAll(".martabak-number").forEach((item, index) => {
            item.querySelector(".martabak-number").textContent = index + 1;
        })
        martabakCount = document.querySelectorAll(".martabak-item").length;
    }
    addMartabak();

    // Form validation script
    document.addEventListener('DOMContentLoaded', function () {
        const form =document.getElementById('orderForm');
        const fields = [
            { id: 'name', errorId: 'name-error' },
            { id: 'phone', errorId: 'phone-error' },
            { id: 'address', errorId: 'address-error'}
        ];

        // 1. Validate fields on input
        form.addEventListener('submit', function (event) {
            let isValid = true;

            fields.forEach(field => {
                const input = document.getElementById(field.id);
                const errorText = document.getElementById(field.errorId);

                if (!input.value.trim()) {
                    isValid = false;
                    input.classList.remove('border-gray-300');
                    input.classList.add('border-red-500', 'ring-2', 'ring-red-500');
                    errorText.classList.remove('hidden');
                } else {
                    input.classList.remove('border-red-500', 'ring-2', 'ring-red-500');
                    input.classList.add('border-gray-300');
                    errorText.classList.add('hidden');
                }
            });
            if (!isValid) {
                event.preventDefault();
            }
        });

        fields.forEach(field => {
            const input = document.getElementById(field.id);
            const errorText = document.getElementById(field.errorId);

            input.addEventListener('input', function (){
                if (this.value.trim()){
                    this.classList.remove('border-red-500', 'ring-2', 'ring-red-500');
                    this.classList.add('border-gray-300');
                    errorText.classList.add('hidden');
                }
            });
        });
    });
</script>

{{template "bottom" .}}
