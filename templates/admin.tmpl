{{template "top" .}}
<title>Admin Dashboard - Martabak tracker</title>
</head>

<body class="bg-gradient-to-br from-amber-50 via-orange-50 to-rose-50 min-h-screen">
    <div class="container mx-auto px-4 py-6 md:py-12">
        <div class="max-w-[95%] mx-auto">
            <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-8">

                <div>
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-2 tracking-tight">
                        Martabak Tracker
                    </h1>
                    <p class="text-gray-600 text-base sm:text-lg">Track and manage all your martabak orders</p>
                </div>
                <div class="flex items-center justify-between sm:justify-end gap-4">
                    <span class="text-gray-700 font-medium text-sm sm:text-base">
                        Welcome, {{.Username}}
                    </span>
                    <form action="/logout" method="POST">
                        <button type="submit"
                            class="px-4 sm:px-5 py-2.5 bg-red-500 text-white text-sm rounded-xl hover:bg-red-600 active:scale-95 transition-all shadow-sm">Logout</button>
                    </form>
                </div>
            </div>
            <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl border border-white/20 overflow-hidden">
                <div class="p-4 sm:p-6 md:p-8">
                    <div class="flex flex-wrap items-center gap-2 mb-6 sm:mb-8">
                        <h2 class="text-xl sm:text-2xl font-semibold text-gray-900 mr-2">Active Orders</h2>
                        <button onclick="location.reload()"
                            class="text-gray-500 hover:text-gray-700 transition-colors p-1.5 rounded-lg hover:bg-gray-100">
                            <span class="text-xl">🔄</span>
                        </button>
                        <span id="lastFetched" class="text-xs sm:text-sm text-gray-500 font-medium"></span>
                        <span id="newOrderBadge" class="text-xs font-semibold text-white bg-red-500 rounded-full px-3 py-1.5 hidden shadow-sm">0 new orders</span>
                    </div>
                    <!-- Mobile card view -->
                    <div class="md:hidden space-y-4">
                        {{range .Orders}}
                        <div class="border border-gray-200 rounded-2xl p-4 bg-white/70">
                            <div class="flex justify-between items-start mb-3">
                                <a href="/customer/{{.ID}}" class="text-blue-600 font-semibold hover:underline text-sm break-all">
                                    {{.ID}}
                                </a>
                                <span class="text-xs font-medium text-gray-700 bg-gray-100 rounded-full px-2.5 py-1 whitespace-nowrap ml-2">{{.Status}}</span>
                            </div>
                            <div class="space-y-1.5 text-sm mb-3">
                                <p class="text-gray-900 font-medium">{{.CustomerName}}</p>
                                <p class="text-gray-600">{{.Phone}}</p>
                                <p class="text-gray-600">{{.Address}}</p>
                            </div>
                            <div class="text-sm text-gray-700 mb-4 space-y-1">
                                {{range $index, $martabak := .Items}}
                                <div class="flex items-center gap-2">
                                    <span class="text-gray-400">{{add $index 1}}</span>
                                    <span>{{$martabak.Size}} {{$martabak.Martabak}}</span>
                                    {{if $martabak.Instructions}}
                                    <span class="text-gray-400" title="{{$martabak.Instructions}}">ⓘ</span>
                                    {{end}}
                                </div>
                                {{end}}
                            </div>
                            <div class="flex gap-2">
                                <form action="/admin/order/{{.ID}}/update" method="POST" class="flex-1">
                                    <select name="status"
                                        class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all bg-white font-medium" onchange="this.form.submit()">
                                        {{$currentStatus := .Status}}
                                        {{range $.Statuses}}
                                        <option {{if eq . $currentStatus}} selected {{end}} value="{{.}}">
                                            {{.}}</option>
                                        {{end}}
                                    </select>
                                </form>
                                <form action="/admin/order/{{.ID}}/delete" method="POST">
                                    <button type="submit"
                                        class="p-2 text-white bg-red-500 rounded-lg hover:bg-red-600 active:scale-95 focus:outline-none focus:ring-2 focus:ring-red-400 transition-all"
                                        onclick="return confirm('Apakah anda yakin ingin menghapus pesanan ini?')">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                        {{end}}
                    </div>

                    <!-- Desktop table view -->
                    <div class="hidden md:block w-full overflow-x-auto rounded-xl border border-gray-200">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-gray-50/80 border-b border-gray-200">
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Order ID</th>
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Status</th>
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Name</th>
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Phone</th>
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Address</th>
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Martabak</th>
                                    <th
                                        class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                                        Action</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white/70 divide-y divide-gray-100">
                                {{range .Orders}}
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                                        <a href="/customer/{{.ID}}"
                                            class="text-blue-600 hover:text-blue-700 font-medium hover:underline">
                                            {{.ID}}
                                        </a>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 font-medium">
                                        {{.Status}}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{{.CustomerName}}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">{{.Phone}}</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">{{.Address}}</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">
                                        <div class="space-y-1">
                                            {{range $index, $martabak := .Items}}
                                            <div class="flex items-center gap-2">
                                                <span class="text-gray-400">{{add $index 1}}</span>
                                                <span class="truncate">{{$martabak.Size}} {{$martabak.Martabak}}</span>
                                                {{if $martabak.Instructions}}
                                                <span class="size-4 text-gray-400 cursor-help"
                                                    title="{{$martabak.Instructions}}">ⓘ</span>
                                                {{end}}
                                            </div>
                                            {{end}}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                                        <div class="flex gap-2">
                                            <form action="/admin/order/{{.ID}}/update" method="POST">
                                                <select name="status"
                                                    class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all bg-white font-medium" onchange="this.form.submit()">
                                                    {{$currentStatus := .Status}}
                                                    {{range $.Statuses}}
                                                    <option {{if eq . $currentStatus}} selected {{end}} value="{{.}}">
                                                        {{.}}</option>
                                                    {{end}}
                                                </select>
                                            </form>
                                            <form action="/admin/order/{{.ID}}/delete" method="POST">
                                                <button type="submit"
                                                    class="p-2 text-white bg-red-500 rounded-lg hover:bg-red-600 active:scale-95 focus:outline-none focus:ring-2 focus:ring-red-400 transition-all"
                                                    onclick="return confirm('Apakah anda yakin ingin menghapus pesanan ini?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none"
                                                        viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const updateTime = () => `Last updated on: ${new Date().toLocaleString()}`
            const lastFetched = document.getElementById("lastFetched");
            const newOrderBadge = document.getElementById("newOrderBadge")

            lastFetched.textContent = updateTime();

            let newOrdersCount = 0;
            const eventSrc = new EventSource("/admin/notifications");
            eventSrc.onmessage = e => {
                newOrdersCount++;
                newOrderBadge.textContent = `${newOrdersCount} new order${newOrdersCount === 1 ? '' : 's' }`
                newOrderBadge.classList.remove("hidden");
                lastFetched.textContent = updateTime();
            }
            eventSrc.onerror = err => console.error("EventSource failed:", err)
        })
    </script>
    {{template "bottom" .}}